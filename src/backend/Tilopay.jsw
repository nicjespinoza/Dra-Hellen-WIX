import { fetch } from 'wix-fetch';
import wixData from 'wix-data';
import { getSecret } from 'wix-secrets-backend';

async function getBearerToken() {
    const apiuser = await getSecret('TILOPAY_API_USER');
    const password = await getSecret('TILOPAY_API_PASSWORD');

    const response = await fetch('https://app.tilopay.com/api/v1/login', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            apiuser: apiuser,
            password: password,
        }),
    });

    if (!response.ok) {
        throw new Error('Error al obtener el token de autenticación');
    }

    const data = await response.json();
    return data.access_token;
}

async function processPayment(paymentData) {
    const key = await getSecret('TILOPAY_API_KEY');
    const bearerToken = await getBearerToken();

    const url = "https://app.tilopay.com/api/v1/processPayment";
    const headers = {
        "Authorization": `Bearer ${bearerToken}`,
        "Content-Type": "application/json",
        "Accept": "application/json"
    };

    const body = {
        "redirect": paymentData.redirectUrl,
        "key": key,
        "amount": paymentData.amount.toString(),
        "currency": "USD",
        "orderNumber": paymentData.id,
        "capture": "1",
        "subscription": "0",
        "platform": "api",
        "returnData": btoa(`user_id=${paymentData.customerEmail}`),
        "hashVersion": "V2",
        ...paymentData.customerInfo
    };

    const response = await fetch(url, {
        method: "POST",
        headers: headers,
        body: JSON.stringify(body)
    });

    const data = await response.json();
    if (!response.ok) {
        throw new Error(data.message || 'Error en el procesamiento del pago');
    }
    
    return data;
}

export async function processTiloPayment(paymentData) {
    try {
        // Validación inicial
        if (!paymentData?.customerEmail || !paymentData?.amount) {
            return { success: false, error: 'Faltan datos requeridos: email y monto son obligatorios' };
        }

        const response = await processPayment(paymentData);

        if (response.url && response.url.startsWith('https://')) {
            // Guardar reporte
            await wixData.insert('Reporte', {
                usuario: paymentData.customerEmail,
                monto: Number(paymentData.amount),
                descripcion: paymentData.descripcion || 'Payment initiated',
                estatus: paymentData.estatus || 'pending',
                referencia: paymentData.referencia || response.transaction_id,
                fechaCreacion: paymentData.fechaCreacion || new Date()
            });

            // Actualizar usuario sin sobrescribir datos existentes
            const userQuery = await wixData.query('User')
                .eq('emailAddress', paymentData.customerEmail)
                .find();

            if (userQuery.items.length > 0) {
                const userId = userQuery.items[0]._id;
                const existingUser = userQuery.items[0]; // Obtener el registro completo

                // Combinar datos existentes con los nuevos
                const updatedUser = {
                    ...existingUser, // Mantener todos los datos existentes
                    ultimoMonto: Number(paymentData.amount),
                    ultimoPago: new Date(),
                    estatus: paymentData.estatus || 'pending',
                    referencia: paymentData.referencia || response.transaction_id,
                    fechaCreacion: paymentData.fechaCreacion || new Date()
                };

                await wixData.update('User', updatedUser);
            }

            return { success: true, redirectUrl: response.url };
        } else {
            return { success: false, error: response.html || 'Respuesta inválida del API de TiloPay' };
        }
    } catch (error) {
        console.error('Payment processing error:', error);
        return { success: false, error: error.message || 'Error procesando el pago' };
    }
}