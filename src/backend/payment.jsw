import wixData from 'wix-data';
import wixUsersBackend from 'wix-users-backend';
import { fetch } from 'wix-fetch';
import { session } from "@wix/site-storage"
import { logEvent } from 'backend/logs.jsw';
import wixSecretsBackend from 'wix-secrets-backend';

async function fetchWithRetry(url, options, retries = 3, delay = 1000) {
    for (let i = 0; i < retries; i++) {
        try {
            const response = await fetch(url, options);
            return response;
        } catch (error) {
            if (i === retries - 1) throw error;
            await new Promise(resolve => setTimeout(resolve, delay));
        }
    }
}



function validatePowertranzString(str) {
    return /^[a-zA-Z0-9\-. ]*$/.test(str);
}

function isValidGuid(str) {
    const guidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    return guidRegex.test(str);
}

function mapPowertranzError(response) {
    const errorMap = {
        '12': 'Transacción inválida',
        '05': 'Transacción denegada',
        '91': 'Emisor no disponible',
        '96': 'Error de sistema',
        '3D3': 'Error en autenticación 3DS',
        'FC3': 'Error en verificación de fraude'
    };
    return errorMap[response.IsoResponseCode] || response.ResponseMessage || 'Error desconocido';
}

export async function completePayment(spiToken, transactionId, userId, csrfToken) {
    try {
        // Validar parámetros de entrada
        if (!spiToken || !transactionId || !userId || !csrfToken) {
            await logEvent('ERROR', 'Parámetros faltantes', { spiToken, transactionId, userId, csrfToken });
            return { success: false, error: 'Faltan parámetros requeridos' };
        }

        if (!isValidGuid(transactionId)) {
            await logEvent('ERROR', 'transactionId inválido', { transactionId });
            return { success: false, error: 'transactionId no es un GUID válido' };
        }

        // Validar usuario
        try {
            await wixUsersBackend.getUser(userId);
        } catch (error) {
            await logEvent('ERROR', 'Usuario no válido', { userId, error: error.message });
            return { success: false, error: 'Usuario no válido' };
        }

        // Buscar transacción en la colección Transacciones
        const transactionQuery = await wixData.query('Transacciones')
            .eq('transactionIdentifier', transactionId)
            .eq('userId', userId)
            .eq('csrfToken', csrfToken)
            .find();

        if (transactionQuery.items.length === 0) {
            await logEvent('ERROR', 'Transacción no encontrada', { transactionId, userId, csrfToken });
            return { success: false, error: 'Transacción no encontrada' };
        }

        const transaction = transactionQuery.items[0];
        const transactionTime = new Date(transaction.createdAt);
        const currentTime = new Date();
        const timeDifference = currentTime.getTime() - transactionTime.getTime();

        // Validar timeout de 5 minutos para SpiToken
        if (timeDifference > 5 * 60 * 1000) {
            await logEvent('ERROR', 'SpiToken expirado', { transactionId, timeDifference });
            return { success: false, error: 'El token de pago ha expirado' };
        }

        // Configurar solicitud a Powertranz
        const url = 'https://staging.ptranz.com/api/spi/payment';
        const options = {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Powertranz-PowertranzId': await wixSecretsBackend.getSecret('PowertranzId'),
                'Powertranz-PowertranzPassword': await wixSecretsBackend.getSecret('PowertranzPassword')
            },
            body: JSON.stringify({
                SpiToken: spiToken,
                TransactionIdentifier: transactionId,
                TotalAmount: transaction.amount,
                CurrencyCode: transaction.currencyCode,
                OrderIdentifier: transaction.orderIdentifier
            })
        };

        // Enviar solicitud a Powertranz
        const response = await fetchWithRetry(url, options);
        const data = await response.json();

        // Registrar respuesta de Powertranz
        await logEvent('INFO', 'Respuesta de Powertranz', { transactionId, response: data });

        // Manejar respuesta
        if (response.ok && data.IsoResponseCode === '00') {
            await wixData.update('Transacciones', {
                _id: transaction._id,
                status: 'COMPLETED',
                authorizationCode: data.AuthorizationCode,
                threeDSStatus: data.ThreeDSecure.AuthenticationStatus
            });
            return { success: true, threeDSStatus: data.ThreeDSecure.AuthenticationStatus };
        } else {
            const errorMessage = mapPowertranzError(data);
            await wixData.update('Transacciones', {
                _id: transaction._id,
                status: 'FAILED',
                error: errorMessage
            });
            await logEvent('ERROR', 'Error en Powertranz', { transactionId, error: errorMessage, response: data });
            return { success: false, error: errorMessage };
        }
    } catch (error) {
        await logEvent('ERROR', 'Error en completePayment', { transactionId, error: error.message });
        return { success: false, error: 'Error inesperado al procesar el pago' };
    }
}